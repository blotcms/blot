[Unit]
Description=Mount instance store
# The script only touches the local disk (nvme list, mkfs, mount) and needs
# no network, so order it after local filesystems are up rather than
# network.target, which gave no real guarantee here.
After=local-fs.target
# Bare metal openresty.service is the rollback target for the proxy
# container and reads the same /var/instance-ssd cache, so it must not start
# before the real disk is mounted either.
Before=openresty.service

[Service]
# oneshot + RemainAfterExit=yes: the script runs once and exits, but the
# unit stays "active" afterwards so other units (docker.service, via its
# docker.service.d drop-in) can order themselves After=/Requires= it. With
# the previous Type=simple, systemd considered the unit "started" the
# instant the process forked, before the mount happened, so anything
# ordered after it could still race the mount.
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ec2-user/scripts/mount-instance-store.sh

[Install]
WantedBy=multi-user.target
