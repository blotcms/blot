# The versions and pins of the software Blot builds and tests with, in one place
# so they can be audited together (scripts/security/check-advisories.js reads
# this file). Plain KEY=VALUE lines, no quotes: it is sourced by shell scripts,
# read by docker compose and by Node (scripts/versions.js), and loaded into
# GitHub Actions by .github/actions/versions. The Dockerfiles declare each ARG
# without a default; whatever builds them passes these (proxy/build/image.sh,
# scripts/development/start.sh, docker-bake.hcl, build.yml, ...).
# scripts/security/check-versions.js checks the file and that nothing else
# repeats a value.
#
# Not covered: the macserver (app/clients/icloud/macserver) runs its own Node
# version on purpose. Its Node version is not set here.
# Left unpinned on purpose: the redis:6 / redis:alpine images of the
# benchmarks and the local test runner, and the Lua rocks pinned by checksum
# inside proxy/Dockerfile.

# Runtime
NODE_VERSION=24.22.1
NODE_BASE=node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

# App image (Dockerfile)
PANDOC_VERSION=3.6.1
NSJAIL_VERSION=3.6
NSJAIL_COMMIT=f78475530b46d0186111a9096b30725f816b55fe

# Proxy build (proxy/Dockerfile)
OPENRESTY_VERSION=1.31.8.1
OPENRESTY_SHA256=b569c63b420f80a4ac8466f2deffe73ed93ab760026532e039c3658409a997f4
NGINX_VERSION=1.31.8
RESTY_OPENSSL_VERSION=3.5.9
RESTY_OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
RESTY_OPENSSL_PATCH_VERSION=3.5.5
RESTY_OPENSSL_PATCH_SHA256=0a30cc762a9d72901e8415a33f7671bb68469d46121061e26afe7b718f47581e
RESTY_PCRE_VERSION=10.49
RESTY_PCRE_SHA256=929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae
DEHYDRATED_TAG=v0.7.2
SOCKPROC_COMMIT=92aba736027bb5d96e190b71555857ac5bb6b2be
NGX_BROTLI_COMMIT=53e0fb55f250f48fe80c0ddbf6c0f7103cdbaae1

# Dev, test and CI images
REDIS_VERSION=6.2.12
REDIS_E2E_IMAGE=redis:7-alpine
MINIO_IMAGE=alpine/minio:RELEASE.2025-10-15T17-29-55Z@sha256:cf23643a6cf9ce159c57643ceb88279e431262282428c9e0bf3a7ef1a97e84b4
TOXIPROXY_VERSION=2.12.0
UBUNTU_IMAGE=ubuntu:24.04
