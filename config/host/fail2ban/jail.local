[DEFAULT]
backend = polling
banaction = iptables-multiport
bantime  = 3600
findtime = 600
maxretry = 3
ignoreip = 127.0.0.1/8 ::1

bantime.increment = true
bantime.factor = 24
bantime.formula = ban.Time * (1<<(ban.Count-1))
bantime.maxtime = 604800

[sshd]
enabled = true
filter = sshd
logpath = /var/log/secure
backend = polling
port = ssh
maxretry = 3
findtime = 300
bantime = 3600
banaction = iptables-multiport

# The nginx-* jails ban http,https over TCP and also over UDP (a second,
# separately named iptables-multiport action), because HTTP/3 (QUIC) is UDP
# 443 and a TCP-only ban would let a banned IP keep talking to the proxy over
# h3. They do not use iptables-allports: that would also block ssh.
[nginx-403]
filter = nginx-403
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 15
bantime = 1800
banaction = iptables-multiport
action = %(action_)s
         iptables-multiport[name=%(__name__)s-udp, port="http,https", protocol=udp]
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-404]
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 80
bantime = 1800
banaction = iptables-multiport
action = %(action_)s
         iptables-multiport[name=%(__name__)s-udp, port="http,https", protocol=udp]
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-429]
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 10 
bantime = 1800
banaction = iptables-multiport
action = %(action_)s
         iptables-multiport[name=%(__name__)s-udp, port="http,https", protocol=udp]
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-444]
filter = nginx-444
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 3
findtime = 120
bantime = 3600
banaction = iptables-multiport
action = %(action_)s
         iptables-multiport[name=%(__name__)s-udp, port="http,https", protocol=udp]
logencoding = auto
polling_file = true
maxlines = 100

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
backend = polling
banaction = iptables-allports
bantime = 1w
findtime = 1d
maxretry = 3

# Standing bans we add by hand, for abusive ranges that rate limits and the
# nginx-* jails don't catch (e.g. a hosting provider scraping slowly with
# rotating user agents). Nothing is ever matched into it: it has no log, so it
# only holds what `fail2ban-client set manual-permaban banip <ip-or-cidr>`
# puts there. The bans are kept in fail2ban's database on the host, not in this
# repo, so the list of banned ranges is not public. Dropped in the kernel, so a
# banned client costs no TLS handshake. See README.md in this directory.
[manual-permaban]
enabled = true
filter = manual-permaban
logpath = /dev/null
backend = polling
port = http,https
bantime = -1
# With increment on (the [DEFAULT] above), a restart rewrites -1 to
# bantime.maxtime, so a "permanent" ban would end a week after it was added.
bantime.increment = false
banaction = iptables-multiport
action = %(action_)s
         iptables-multiport[name=%(__name__)s-udp, port="http,https", protocol=udp]
