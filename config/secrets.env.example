# /etc/blot/secrets.env - docker --env-file for the units (proxy/deploy/common.sh).
#
# A unit gets this file, then /etc/blot/proxy.env (proxy/deploy/proxy.env.example),
# so a key in both wins from proxy.env. Plain KEY=VALUE lines: no `export`, no
# quotes. Node reads these in config/index.js, which has the defaults.
#
# Not set here: the image sets NODE_ENV, NODE_PATH and the browser path, and the
# deploy sets each unit's own values (BLOT_UNIT, CONTAINER_NAME, the sockets,
# BLOT_TMP_DIRECTORY, the sandbox and egress proxy, heap sizes).

# Flags
BLOT_CACHE=true
BLOT_DEBUG=false

# Required. Base domain; the same as BLOT_HOST in proxy.env.
BLOT_HOST=

# Redis: the socket on the combined host (/run/blot/redis/redis.sock, no
# `unix:`), else a host. The host cycle writes the socket (config/host/cycle.sh).
BLOT_REDIS_SOCKET=
BLOT_REDIS_HOST=

# The proxy's purge listener, and the token it checks (set it here first, then
# in proxy.env). See proxy/README.md "Cache purging".
BLOT_REVERSE_PROXY_URLS=http://127.0.0.1:8077
BLOT_PURGE_TOKEN=

# Admin account and address for admin emails
BLOT_ADMIN_UID=
BLOT_ADMIN_EMAIL=

# A stable random secret (`openssl rand -hex 32`). If unset, Blot warns and
# makes one per process, so every dashboard session ends at each restart.
BLOT_SESSION_SECRET=
BLOT_BACKUP_SECRET=
BLOT_WEBHOOKS_SECRET=

# Stripe
BLOT_STRIPE_KEY=
BLOT_STRIPE_SECRET=
BLOT_STRIPE_WEBHOOK_SECRET=

# PayPal
BLOT_PAYPAL_CLIENT_ID=
BLOT_PAYPAL_SECRET=
BLOT_PAYPAL_WEBHOOK_ID=
BLOT_PAYPAL_MONTHLY_4=
BLOT_PAYPAL_YEARLY_44=
BLOT_PAYPAL_MONTHLY_5=
BLOT_PAYPAL_YEARLY_55=
BLOT_PAYPAL_MONTHLY_6=
BLOT_PAYPAL_YEARLY_72=

# Dropbox
BLOT_DROPBOX_APP_KEY=
BLOT_DROPBOX_APP_SECRET=
BLOT_DROPBOX_FULL_KEY=
BLOT_DROPBOX_FULL_SECRET=

# Google Drive: comma-separated service account IDs
BLOT_GOOGLEDRIVE_SERVICE_ACCOUNT_IDS=

# iCloud: the macserver (app/clients/icloud/macserver)
BLOT_ICLOUD_SERVER_ADDRESS=
BLOT_ICLOUD_SERVER_SECRET=
BLOT_ICLOUD_EMAIL=

# YouTube, for fetching video player codes
BLOT_YOUTUBE_SECRET=

# Mailgun, for sending emails to customers
BLOT_MAILGUN_KEY=

# Bunny, for purging cdn.blot.im
BUNNY_API_SECRET=

# AWS key for the storage bucket (the IAM user config/storage-bucket/setup.sh
# creates). Leave unset to use the AWS SDK's default credential chain.
BLOT_AWS_KEY=
BLOT_AWS_SECRET=

# Bucket for generated per-blog assets (config/storage-bucket/README.md). They
# live nowhere else, so the app will not start without it.
BLOT_STORAGE_BUCKET=
BLOT_STORAGE_REGION=us-west-2
# Only for a simulated S3 such as MinIO in development
# BLOT_STORAGE_ENDPOINT=

# Route 53 hosted zone of BLOT_HOST, where the scheduler answers the DNS
# challenge to renew the wildcard certificate (uses BLOT_AWS_KEY above). To try
# it against Let's Encrypt staging set BLOT_ACME_DIRECTORY_URL to
# https://acme-staging-v02.api.letsencrypt.org/directory
BLOT_WILDCARD_SSL_HOSTED_ZONE_ID=
# BLOT_ACME_DIRECTORY_URL=

# Optional tuning; config/index.js has the defaults
# BLOT_CACHE_SCALE=1
# BLOT_GIT_INTERACTIVE_PROCESSES=4
# BLOT_GIT_BACKGROUND_PROCESSES=2
# BLOT_FOLDER_CACHE_MAX_BYTES=
# BLOT_FOLDER_CACHE_MAX_FILE_BYTES=
