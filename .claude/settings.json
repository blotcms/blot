{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/development/lint.sh claude-hook",
            "timeout": 60,
            "statusMessage": "Formatting and linting"
          }
        ]
      }
    ]
  }
}
