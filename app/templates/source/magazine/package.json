{
  "name": "Magazine",
  "locals": {
    "accent_color": "#0078D9",
    "background_color": "#fff",
    "text_color": "#000",
    "page_size": 20,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "relative_dates": false,
    "sticky_navigation": true,
    "show_tags_in_navigation": true,
    "show_featured_entry": true,
    "syntax_highlighter": {
      "id": "stackoverflow-light"
    },
    "syntax_highlighter_font": {
      "id": "system-mono",
      "font_size": 15
    },
    "body_font": {
      "font_size": 16,
      "line_height": 1.5
    },
    "heading_font": {
      "id": "system-sans",
      "font_size": 36,
      "line_height": 1.15
    },
    "demo_folder": "bjorn",
    "template_categories": [
      "writing"
    ]
  },
  "isPublic": true,
  "views": {
    "style": {
      "url": "/style.css"
    },
    "tags.html": {
      "url": "/tags"
    },
    "js-barbra.js": {
      "url": "/js-barba.js"
    },
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "tagged.html": {
      "partials": {
        "title": "{{{tag}}} - {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
