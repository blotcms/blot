{
  "name": "Gallery",
  "popularity": 70,
  "locals": {
    "page_size": 96,
    "page_size_range": [12, 192],
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#FFFFFF",
    "text_color": "#000000",
    "link_color": "#0000FF",
    "font": {
      "id": "system-sans",
      "font_size": 14,
      "line_height": 1.4
    },
    "syntax_highlighter": {
      "id": "stackoverflow-light"
    },
    "syntax_highlighter_font": {
      "id": "system-mono",
      "font_size": 13
    },
    "profile_image": {},
    "sticky_navigation": false,
    "navigation_alignment": "justified",
    "navigation_alignment_options": [
      "justified",
      "left",
      "right",
      "center"
    ],
    "show_tags_in_navigation": true,
    "thumbnail_size": 120,
    "thumbnail_size_range": [60, 160],
    "spacing": 2,
    "spacing_range": [0, 5],
    "demo_folder": "bjorn"
  },
  "views": {
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "tagged.html": {
      "partials": {
        "title": "Entries tagged {{{tag}}} from {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
