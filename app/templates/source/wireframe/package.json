{
  "name": "Wireframe",
  "isPublic": false,
  "locals": {
    "page_size": 12,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#ffffff",
    "text_color": "#111111",
    "link_color": "#111111",
    "body_font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.5
    },
    "heading_font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.3
    },
    "syntax_highlighter": {
      "id": "stackoverflow-light"
    },
    "syntax_highlighter_font": {
      "id": "system-mono",
      "font_size": 14
    },
    "favicon_url": "",
    "logo_url": "",
    "navigation_alignment": "left",
    "navigation_alignment_options": [
      "left",
      "right",
      "center",
      "justified"
    ],
    "sticky_navigation": false,
    "footer_navigation": false,
    "show_tags": true,
    "max_width": 720,
    "max_width_range": [400, 1200],
    "spacing": 1,
    "spacing_range": [0, 5]
  },
  "views": {
    "public": {
      "partials": {
        "title": "Index of {{{path}}}",
        "description": "All the files and folders inside {{{path}}}"
      }
    },
    "style": {
      "url": "/style.css"
    },
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "tagged.html": {
      "partials": {
        "title": "Entries tagged {{{tag}}} from {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
