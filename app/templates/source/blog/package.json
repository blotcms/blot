{
  "name": "Blog",
  "popularity": 95,
  "locals": {
    "page_size": 20,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#FFFFFF",
    "text_color": "#111111",
    "links_color": "#111111",
    "font": {
      "id": "verdana",
      "font_size": 11,
      "line_height": 1.8
    },
    "title_font": {
      "id": "gill-sans",
      "font_size": 19
    },
    "demo_folder": "notes",
    "syntax_highlighter": {
      "id": "solarized-light"
    },
    "syntax_highlighter_font": {
      "id": "menlo",
      "font_size": 10
    },
    "logo_url": "",
    "navigation_alignment": "right",
    "navigation_alignment_options": [
      "left",
      "right",
      "center"
    ],
    "navigation_location": "left",
    "navigation_location_options": [
      "left",
      "right"
    ],
    "sticky_navigation": false,
    "uppercase_navigation": true,
    "show_tags": true,
    "show_adjacent_posts": true,
    "index_layout": "post_in_full",
