{
  "name": "Keynote",
  "locals": {
    "page_size": 12,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#ffffff",
    "text_color": "#111111",
    "link_color": "#111111",
    "body_font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.5
    },
    "heading_font": {
      "id": "system-sans",
      "font_size": 20,
      "line_height": 1.3
    },
    "syntax_highlighter": {
      "id": "stackoverflow-light"
    },
    "syntax_highlighter_font": {
      "id": "menlo",
      "font_size": 13
    },
    "favicon_url": "",
    "logo_url": "",
    "navigation_alignment": "justified",
    "navigation_alignment_options": [
      "justified",
      "left",
      "right",
      "center"
    ],
    "sticky_navigation": false,
    "slide_width": 320,
    "slide_width_range": [200, 560],
    "content_width": 800,
    "content_width_range": [480, 1200],
    "spacing": 4,
    "spacing_range": [1, 8]
  },
  "isPublic": false,
  "views": {
    "public": {
      "partials": {
        "title": "Index of {{{path}}}",
        "description": "All the files and folders inside {{{path}}}"
      }
    },
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "tagged.html": {
      "partials": {
        "title": "Entries tagged {{{tag}}} from {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
