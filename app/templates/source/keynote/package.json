{
  "name": "Keynote",
  "popularity": 12,
  "locals": {
    "page_size": 30,
    "page_size_range": [1, 100],
    "lang": "en",
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#000000",
    "text_color": "#ffffff",
    "link_color": "#ffffff",
    "font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.5
    },
    "syntax_highlighter": {
      "id": "stackoverflow-light"
    },
    "syntax_highlighter_font": {
      "id": "menlo",
      "font_size": 13
    },
    "profile_image": {},
    "navigation_alignment": "justified",
    "navigation_alignment_options": [
      "justified",
      "left",
      "right",
      "center"
    ],
    "sticky_navigation": true,
    "show_captions": true,
    "drift": true,
    "slide_size": 5,
    "slide_size_range": [1, 10],
    "content_width": 600,
    "content_width_range": [400, 1200],
    "spacing": 4,
    "spacing_range": [1, 8],
    "demo_folder": "sergey"
  },
  "views": {
    "public": {
      "partials": {
        "title": "Index of {{path}}",
        "description": "All the files and folders inside {{path}}"
      }
    },
    "archives.html": {
      "url": "/archives",
      "locals": {
        "page_size": 100
      },
      "partials": {
        "title": "Archives - {{title}}",
        "description": "All the entries posted on {{title}}"
      }
    },
    "tagged.html": {
      "locals": {
        "page_size": 100
      },
      "partials": {
        "title": "{{tag}} - {{title}}",
        "description": "All of the entries posted on {{title}} tagged {{tag}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{title}}",
        "description": "The latest entries posted on {{title}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{error.title}} - {{title}}",
        "description": "Error on {{title}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{entry.title}} - {{title}}",
        "description": "{{entry.summary}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{title}}",
        "description": "Search all the entries posted on {{title}}"
      }
    }
  }
}
