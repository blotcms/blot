BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Blot//Organization template//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:{{{title}}}
{{! Every event still to come (upcoming_events). Times are written without a zone, so calendar apps read them as local time. }}
{{#upcoming_events}}
BEGIN:VEVENT
UID:{{{id}}}
DTSTAMP:{{#formatDate}}YYYYMMDD[T]HHmmss{{/formatDate}}
{{#event.timed}}
DTSTART:{{#formatEvent}}YYYYMMDD[T]HHmmss{{/formatEvent}}
{{/event.timed}}
{{#event.allDay}}
DTSTART;VALUE=DATE:{{#formatEvent}}YYYYMMDD{{/formatEvent}}
{{/event.allDay}}
SUMMARY:{{{title}}}
{{#metadata.venue}}
LOCATION:{{{metadata.venue}}}
{{/metadata.venue}}
URL:{{{absoluteURL}}}
END:VEVENT
{{/upcoming_events}}
END:VCALENDAR
