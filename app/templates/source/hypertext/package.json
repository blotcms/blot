{
  "name": "Hypertext",
  "popularity": 15,
  "locals": {
    "index_layout": "title_and_summary",
    "index_layout_options": [
      "titles",
      "title_and_summary",
      "post_in_full"
    ],
    "page_size": 5,
    "page_size_range": [1, 200],
    "lang": "en",
    "sort_by": "date",
    "sort_by_options": ["date"],
    "sort_order": "asc",
    "background_color": "#fff",
    "text_color": "rgb(0, 0, 0)",
    "link_color": "rgb(48, 84, 235)",
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "show_backlinks": true,
    "syntax_highlighter": {
      "id": "solarized-light"
    },
    "syntax_highlighter_font": {
      "id": "plex-mono",
      "font_size": 14,
      "line_height": 1.5
    },
    "font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.4
    },
    "profile_image": {},
    "sticky_navigation": true,
    "collapse_navigation_by_default": true,
    "navigation_width": 280,
    "navigation_width_range": [180, 420],
    "content_width": 800,
    "content_width_range": [560, 1200],
    "spacing": 1,
    "spacing_range": [0, 3],
    "demo_folder": "hypertext"
  },
  "views": {
    "archives.html": {
      "url": "/archives"
    },
    "search.html": {
      "url": "/search"
    },
    "pagination.html": {
      "url": "/pagination/:page",
      "locals": {
        "page_size": 100
      }
    },
    "tagged.html": {
      "partials": {
        "title": "{{{tag}}} - {{{title}}}",
        "description": "All entries tagged {{{tag}}} on {{{title}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "Latest posts on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.title}}} - {{{title}}}"
      }
    },
    "error.html": {
      "partials": {
        "title": "{{error.title}} - {{{title}}}",
        "description": "{{error.message}}"
      }
    }
  }
}
