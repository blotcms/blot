{
  "name": "Profile",
  "isPublic": false,
  "locals": {
    "author": "",
    "description": "",
    "email": "",
    "microblog_user": "",
    "page_size": 20,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#ffffff",
    "text_color": "#424a52",
    "link_color": "#000000",
    "accent_color": "#ee4792",
    "highlight_color": "#fcdae9",
    "body_font": {
      "id": "system-sans",
      "font_size": 17,
      "line_height": 1.7
    },
    "heading_font": {
      "id": "system-sans",
      "font_size": 30,
      "line_height": 1.35
    },
    "syntax_highlighter": {
      "id": "ir-black"
    },
    "syntax_highlighter_font": {
      "id": "source-code",
      "font_size": 13,
      "line_height": 1.5
    },
    "max_width": 600,
    "max_width_range": [400, 900],
    "navigation_alignment": "right",
    "navigation_alignment_options": ["left", "center", "right"],
    "sticky_navigation": false
  },
  "views": {
    "tagged": {
      "partials": {
        "title": "Entries tagged {{{tag}}} from {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "error": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "public": {
      "partials": {
        "title": "Index of {{{path}}}",
        "description": "All the files and folders inside {{{path}}}"
      }
    },
    "script": {
      "url": "/script.js"
    },
    "sitemap": {
      "url": "/sitemap.xml"
    },
    "robots": {
      "url": "/robots.txt"
    },
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "entries.html": {
      "locals": {
        "landing_layout": true
      },
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "locals": {
        "hide_footer_search": true
      },
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
