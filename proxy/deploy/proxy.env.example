# /etc/blot/proxy.env - docker --env-file for the proxy containers
# (proxy/deploy/blue-green.sh).
#
# A unit (OpenResty and Node in one container, #2119) gets this file AFTER
# /etc/blot/secrets.env, so a key in both wins from here, Node included. The
# deploy refuses a key the two files set to different values (BLOT_HOST and
# BLOT_PURGE_TOKEN are the likely ones: keep them equal or keep them in one).
# Plain KEY=VALUE lines: no `export`, no quotes. See proxy/README.md
# "Runtime settings" for what each does.

# Required. Base domain; the image's vhosts are built for the same value.
BLOT_HOST=blot.im

# Required (the scripts refuse an empty value: it would override the image's
# default with an empty host). Redis that holds certificates for custom
# domains and the domain allowlist: a host (port 6379) or, with Redis on the
# same host, unix:/run/blot/redis/redis.sock (the container needs /run/blot
# mounted). A missing socket is treated as an unreachable Redis.
PROXY_REDIS_HOST=

# Required (an empty value would bind the purge listener on every interface).
# The address of the purge listener (:8077) that Node purges the cache through.
# Loopback, because units run with host networking and share the host's
# loopback. It must match BLOT_REVERSE_PROXY_URLS in /etc/blot/secrets.env.
PROXY_PRIVATE_IP=127.0.0.1

# Required on the proxy if BLOT_PURGE_TOKEN is set on Node (see proxy/README.md
# "Cache purging"); set on Node first.
# BLOT_PURGE_TOKEN=

# Recommended. A long random string (e.g. `openssl rand -hex 32`) shared by every
# proxy instance: the secret dehydrated's hook calls carry to the :8999 hook
# server. Instances share :8999 (reuseport), so a call can land on either, and
# each generates its own secret if this is unset: fine for one proxy, broken
# for two. Never log or commit it.
# PROXY_ACME_HOOK_SECRET=

PROXY_SERVER_LABEL=us
PROXY_RESOLVER=8.8.8.8 ipv6=off

# Do not set PROXY_ACME_CA here: it selects the ACME directory certificates
# are issued from (default Let's Encrypt production), and the deploy scripts
# refuse anything else. try-issuance.sh sets it, for a throwaway container.
